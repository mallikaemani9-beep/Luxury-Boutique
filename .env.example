# ==========================================
# Aura Atelier - Boutique E-Commerce Environment Config
# ==========================================

# Backend Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Security & Authentication
JWT_SECRET_KEY=aura_atelier_boutique_super_secret_jwt_key_2026_luxury_brand
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default, or PostgreSQL for production)
DATABASE_URL=sqlite:///./backend/boutique.db
# For PostgreSQL: postgresql://username:password@localhost:5432/boutique_db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payment Gateway Configuration (For Production)
# Get keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cloudinary / Image Storage (Optional for production image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
